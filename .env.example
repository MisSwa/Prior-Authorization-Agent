# Copy this file to .env and fill in your values.
# .env is excluded from version control — never commit real keys.

# Required: Anthropic API key for Claude model calls
ANTHROPIC_API_KEY=sk-ant-...

# Optional: LangSmith observability (Phase 4)
# Set LANGCHAIN_TRACING_V2=true to enable per-run traces in LangSmith.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=prior-auth-assistant
